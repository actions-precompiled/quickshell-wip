#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Orchestrate quickshell prebuilds. Python 3 stdlib only (puppet for docker/gh)."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
IMAGE_NAME = os.environ.get("IMAGE_NAME", "quickshell-buildenv")
IMAGE_TAG = os.environ.get("IMAGE_TAG", "local")
UPSTREAM_API = os.environ.get("UPSTREAM_REPO_API", "quickshell-mirror/quickshell")
DEFAULT_TARGETS = ("linux-amd64", "linux-aarch64")


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def env_flag(name: str) -> bool:
    return name in os.environ and os.environ[name] not in ("", "0", "false", "False")


def targets_from_env() -> list[str]:
    raw = os.environ.get("TARGETS", "").strip()
    if not raw:
        # Single-arch default: match host so local/docker-native builds just work
        machine = os.uname().machine
        if machine in ("aarch64", "arm64"):
            return ["linux-aarch64"]
        return ["linux-amd64"]
    return raw.split()


def build_output_dir() -> Path:
    return Path(os.environ.get("BUILD_OUTPUT_DIR", ROOT / "target")).resolve()


def run(cmd: list[str], *, check: bool = True, **kwargs) -> subprocess.CompletedProcess:
    eprint("+", " ".join(cmd))
    return subprocess.run(cmd, check=check, **kwargs)


def version_bare(version: str) -> str:
    return version[1:] if version.startswith("v") else version


def find_tarballs(out_root: Path, version: str, target: str) -> list[Path]:
    bare = version_bare(version)
    d = out_root / target
    if not d.is_dir():
        return []
    matches = sorted(d.glob(f"quickshell-{bare}-{target}.tar.gz"))
    if matches:
        return matches
    # Fallback: any tarball for this target that mentions the version
    return sorted(
        p
        for p in d.glob("*.tar.gz")
        if bare in p.name or version in p.name
    )


def smoke_test_tarball(tarball: Path) -> None:
    """Extract the package and verify the launcher runs (stdlib only)."""
    eprint(f"\nSmoke test: {tarball.name}")
    if not tarball.is_file():
        raise FileNotFoundError(f"tarball missing: {tarball}")

    with tempfile.TemporaryDirectory(prefix="qs-smoke-") as tmp:
        tmp_path = Path(tmp)
        with tarfile.open(tarball, "r:gz") as tf:
            # Python 3.12+ filter=; older uses default extract
            try:
                tf.extractall(tmp_path, filter="data")
            except TypeError:
                tf.extractall(tmp_path)

        # Layout: quickshell/{bin,lib,plugins,...}
        roots = [p for p in tmp_path.iterdir() if p.is_dir()]
        if len(roots) != 1:
            raise RuntimeError(
                f"expected one top-level dir in tarball, got: {[p.name for p in roots]}"
            )
        prefix = roots[0]
        bin_dir = prefix / "bin"
        launcher = bin_dir / "quickshell"
        qs = bin_dir / "qs"
        real_bin = bin_dir / "quickshell.bin"
        lib_dir = prefix / "lib"
        plugins = prefix / "plugins"
        buildinfo = prefix / "BUILDINFO.txt"

        required = {
            "bin/quickshell": launcher,
            "bin/qs": qs,
            "bin/quickshell.bin": real_bin,
            "lib/": lib_dir,
            "plugins/": plugins,
            "BUILDINFO.txt": buildinfo,
        }
        missing = [name for name, path in required.items() if not path.exists()]
        if missing:
            raise RuntimeError(f"package missing paths: {missing}")

        if not os.access(launcher, os.X_OK):
            raise RuntimeError(f"launcher not executable: {launcher}")

        eprint("--- BUILDINFO ---")
        eprint(buildinfo.read_text(encoding="utf-8", errors="replace").rstrip())

        # Xvfb = X Virtual Framebuffer (shadow/virtual X server for headless GUI smoke)
        xvfb_run = shutil.which("xvfb-run")
        if not xvfb_run:
            raise RuntimeError(
                "smoke requires Xvfb (xvfb-run). Install: apt install xvfb "
                "(plus mesa GL/EGL libs, e.g. libgl1 libegl1 libglx-mesa0)"
            )
        eprint(f"Using Xvfb via {xvfb_run}")

        def is_loader_error(text: str) -> bool:
            low = text.lower()
            return any(
                s in low
                for s in (
                    "error while loading shared libraries",
                    "cannot open shared object",
                    "cannot open shared object file",
                )
            )

        # Real X11 display under Xvfb; xcb is the usual Qt desktop path
        smoke_env = {
            **os.environ,
            "QT_QPA_PLATFORM": os.environ.get("QT_QPA_PLATFORM", "xcb"),
            "QT_DEBUG_PLUGINS": "0",
            "LIBGL_ALWAYS_SOFTWARE": "1",
        }

        for args in (["--help"], ["--version"]):
            # xvfb-run -a: pick a free display; -s: server args (screen size / depth)
            cmd = [
                xvfb_run,
                "--auto-servernum",
                "--server-args=-screen 0 1280x720x24",
                str(launcher),
                *args,
            ]
            eprint("+", " ".join(cmd))
            proc = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=90,
                env=smoke_env,
            )
            out = (proc.stdout or "") + (proc.stderr or "")
            for line in out.splitlines()[:20]:
                eprint(" ", line)

            if is_loader_error(out):
                raise RuntimeError(f"smoke failed for {args}: dynamic linker error")

            has_usage = "usage:" in out.lower() or "options:" in out.lower()
            if args == ["--help"]:
                if not has_usage:
                    raise RuntimeError(
                        f"smoke failed for --help under Xvfb "
                        f"(exit {proc.returncode}): no usage text"
                    )
            elif args == ["--version"]:
                if not out.strip():
                    raise RuntimeError(
                        f"smoke failed for --version under Xvfb "
                        f"(exit {proc.returncode}): empty output"
                    )

        eprint(f"✓ Smoke test passed (Xvfb): {tarball.name}")


def smoke_test_version(version: str, targets: list[str], out_root: Path) -> None:
    if env_flag("SKIP_SMOKE"):
        eprint("SKIP_SMOKE set — skipping smoke tests")
        return
    eprint("\n" + "=" * 40)
    eprint(f"Smoke testing {version}")
    eprint("=" * 40)
    for target in targets:
        tarballs = find_tarballs(out_root, version, target)
        if not tarballs:
            raise FileNotFoundError(
                f"no tarball for {version} / {target} under {out_root / target}"
            )
        for tarball in tarballs:
            smoke_test_tarball(tarball)


def curl_json(url: str, *, headers: list[tuple[str, str]] | None = None) -> object:
    """GET JSON via curl (system CA store; avoids broken Python SSL on NixOS)."""
    if not shutil.which("curl"):
        raise RuntimeError("curl is required for HTTPS fetches")

    cmd = [
        "curl",
        "--fail",
        "--silent",
        "--show-error",
        "--location",
        "--max-time",
        "60",
        "-H",
        "Accept: application/vnd.github+json",
        "-H",
        "User-Agent: actions-precompiled-quickshell",
        "-H",
        "X-GitHub-Api-Version: 2022-11-28",
    ]
    for key, value in headers or []:
        cmd.extend(["-H", f"{key}: {value}"])
    cmd.append(url)

    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        raise RuntimeError(f"curl failed ({proc.returncode}) for {url}: {err}")
    return json.loads(proc.stdout)


def github_api_json(path: str) -> object:
    """GET api.github.com path via curl. Uses GH_TOKEN / GITHUB_TOKEN if set."""
    url = f"https://api.github.com{path}"
    headers: list[tuple[str, str]] = []
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        headers.append(("Authorization", f"Bearer {token}"))
    return curl_json(url, headers=headers)


def list_upstream_tags() -> list[str]:
    tags: list[str] = []
    page = 1
    while True:
        data = github_api_json(
            f"/repos/{UPSTREAM_API}/tags?per_page=100&page={page}"
        )
        if not isinstance(data, list) or not data:
            break
        for item in data:
            name = item.get("name")
            if name:
                tags.append(name)
        if len(data) < 100:
            break
        page += 1
    return tags


def list_released_tags() -> list[str]:
    """Tags already released on *this* repo (via gh if available, else GitHub API)."""
    # Prefer gh when authenticated (handles private repos cleanly)
    if shutil.which("gh"):
        proc = run(
            ["gh", "release", "list", "--json", "tagName", "--jq", ".[].tagName"],
            check=False,
            capture_output=True,
            text=True,
        )
        if proc.returncode == 0 and proc.stdout is not None:
            return [line.strip() for line in proc.stdout.splitlines() if line.strip()]

    # Fallback: GITHUB_REPOSITORY=owner/repo
    repo = os.environ.get("GITHUB_REPOSITORY")
    if not repo:
        eprint("No gh and no GITHUB_REPOSITORY — treating released set as empty")
        return []
    tags: list[str] = []
    page = 1
    try:
        while True:
            data = github_api_json(
                f"/repos/{repo}/releases?per_page=100&page={page}"
            )
            if not isinstance(data, list) or not data:
                break
            for item in data:
                name = item.get("tag_name")
                if name:
                    tags.append(name)
            if len(data) < 100:
                break
            page += 1
    except RuntimeError as exc:
        eprint(f"Warning: could not list releases ({exc}); assuming none")
        return []
    return tags


def versions_to_build(cli_versions: list[str]) -> list[str]:
    if cli_versions:
        return cli_versions

    eprint(f"Fetching upstream tags from {UPSTREAM_API}...")
    upstream = set(list_upstream_tags())
    eprint(f"  upstream: {len(upstream)}")

    eprint("Fetching existing releases from this repository...")
    released = set(list_released_tags())
    eprint(f"  released: {len(released)}")

    missing = sorted(upstream - released)
    # Keep a stable-ish order: prefer sorting by version-ish string
    return missing


def host_docker_arch() -> str:
    """Map uname -m to Docker TARGETARCH (amd64 / arm64)."""
    machine = os.uname().machine
    if machine in ("x86_64", "amd64"):
        return "amd64"
    if machine in ("aarch64", "arm64"):
        return "arm64"
    return machine


def ensure_image() -> None:
    if env_flag("SKIP_IMAGE_BUILD"):
        eprint(f"SKIP_IMAGE_BUILD set — using existing {IMAGE_NAME}:{IMAGE_TAG}")
        return
    arch = host_docker_arch()
    eprint(f"Building Docker image {IMAGE_NAME}:{IMAGE_TAG} (TARGETARCH={arch})...")
    run(
        [
            "docker",
            "build",
            "--build-arg",
            f"TARGETARCH={arch}",
            "-t",
            f"{IMAGE_NAME}:{IMAGE_TAG}",
            str(ROOT),
        ]
    )


def build_for_target(version: str, target: str, out_root: Path) -> Path:
    eprint(f"\nBuilding {version} for {target}...")
    out_dir = out_root / target
    out_dir.mkdir(parents=True, exist_ok=True)

    script = ROOT / "scripts" / "build_and_package.sh"
    cmd = [
        "docker",
        "run",
        "--rm",
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        "-v",
        f"{out_dir}:/out",
        "-v",
        f"{script}:/usr/local/bin/build_and_package.sh:ro",
        "-e",
        f"QUICKSHELL_VERSION={version}",
        "-e",
        f"BUILD_TARGET={target}",
        "-e",
        "OUTPUT_DIR=/out",
        "-e",
        "HOME=/tmp",
        "-e",
        "XDG_CACHE_HOME=/tmp/.cache",
        "-e",
        "LANG=C.UTF-8",
        "-e",
        "LC_ALL=C.UTF-8",
        f"{IMAGE_NAME}:{IMAGE_TAG}",
    ]
    run(cmd)
    return out_dir


def publish_release(version: str, targets: list[str], out_root: Path) -> None:
    release_tag = version
    eprint(f"Creating GitHub release {release_tag}...")
    notes = f"""Prebuilt quickshell {release_tag} (Qt-bundled, relocatable tree).

Install: extract the tarball and put `bin/` on your PATH (mise/asdf/manual).

Targets: {", ".join(targets)}

Upstream: https://github.com/quickshell-mirror/quickshell
"""
    # Idempotent create
    create = run(
        [
            "gh",
            "release",
            "create",
            release_tag,
            "--title",
            f"quickshell {release_tag}",
            "--notes",
            notes,
            "--latest=false",
        ],
        check=False,
        input=b"",
    )
    if create.returncode not in (0,):
        eprint("release create returned non-zero (may already exist); continuing upload")

    eprint("Uploading artifacts...")
    for target in targets:
        tarballs = sorted((out_root / target).glob("*.tar.gz"))
        for tarball in tarballs:
            run(
                [
                    "gh",
                    "release",
                    "upload",
                    release_tag,
                    "--clobber",
                    str(tarball),
                ]
            )
    eprint(f"✓ Released {release_tag}")


def build_release(
    version: str,
    targets: list[str],
    out_root: Path,
    *,
    publish: bool,
    do_smoke: bool,
) -> None:
    eprint("\n" + "=" * 40)
    eprint(f"Building quickshell version {version}")
    eprint("=" * 40)

    for target in targets:
        build_for_target(version, target, out_root)

    eprint(f"\nBuilt artifacts for {version}:")
    for target in targets:
        d = out_root / target
        if d.is_dir():
            run(["ls", "-lh", str(d)], check=False)

    # Smoke is optional here so CI can upload artifacts first, then smoke.
    if do_smoke:
        smoke_test_version(version, targets, out_root)

    if not publish:
        eprint("Local build only — pass --publish to create a GitHub release")
        return

    publish_release(version, targets, out_root)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Build precompiled quickshell tarballs. "
            "Local by default; use --publish to upload GitHub releases."
        )
    )
    parser.add_argument(
        "versions",
        nargs="*",
        help="Upstream tags to build (default: tags not yet released here)",
    )
    parser.add_argument(
        "--publish",
        action="store_true",
        help="Create GitHub releases and upload tarballs (also: PUBLISH=1)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="List versions/targets and exit (also: DRY_RUN=1)",
    )
    parser.add_argument(
        "--skip-smoke",
        action="store_true",
        help="Skip post-build smoke tests (also: SKIP_SMOKE=1)",
    )
    parser.add_argument(
        "--smoke-only",
        action="store_true",
        help="Only smoke-test existing tarballs under target/ (no docker build)",
    )
    args = parser.parse_args(argv)
    if args.skip_smoke:
        os.environ["SKIP_SMOKE"] = "1"

    targets = targets_from_env()
    versions = versions_to_build(args.versions)
    out_root = build_output_dir()
    publish = args.publish or env_flag("PUBLISH")
    do_smoke = not (args.skip_smoke or env_flag("SKIP_SMOKE"))

    if not versions:
        eprint("No versions to build.")
        return 0

    eprint(f"\nVersions to build ({len(versions)}):")
    for v in versions:
        eprint(f"  - {v}  [targets: {' '.join(targets)}]")
    eprint(f"Publish: {'yes' if publish else 'no (local only)'}")
    eprint(f"Smoke: {'yes' if do_smoke and not args.smoke_only else ('only' if args.smoke_only else 'no')}")

    if args.dry_run or env_flag("DRY_RUN"):
        eprint("Dry-run — exiting without building")
        return 0

    if args.smoke_only:
        for version in versions:
            smoke_test_version(version, targets, out_root)
        eprint("\n✓ Smoke-only finished")
        return 0

    ensure_image()

    for version in versions:
        build_release(
            version,
            targets,
            out_root,
            publish=publish,
            do_smoke=do_smoke,
        )

    eprint("\n✓ All requested builds finished")
    return 0


if __name__ == "__main__":
    sys.exit(main())
